mod greet

extern "C"
{
    fn printf(fmt:string,...): i32
}

pub fn a(): i32
{
    10
}
fn main(): i32
{
    let x: i32 = 10
    for(i in 0 .. 10)
    {
        print(i)
    }
    match a()
    {
        10 -> {
            print("a is 10")
        }
    }
